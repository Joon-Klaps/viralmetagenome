// Regression guard for the LazyMap thread-safety crash
// (https://github.com/nf-core/viralmetagenome/issues/290).
//
// Both tests invoke the same RACE workflow (see lazymap_race.nf) with a
// different `mode` string:
//   1. 'vanilla' — uses the previous broken `new JsonSlurper().parseText(...)`
//      pattern. It MUST throw NPEs; if it doesn't, the second test isn't a
//      meaningful guard (the underlying Groovy LazyMap was probably fixed, or
//      we tuned the load too low) and we want CI to tell us.
//   2. 'current' — calls the real getMapFromJson exported from main.nf.
//      It MUST produce zero NPEs.

nextflow_workflow {

    name "LazyMap thread-safety regression"
    script "./lazymap_test.nf"
    workflow "RACE"
    tag "subworkflows"
    tag "subworkflows_local"
    tag "utils_nfcore_viralmetagenome_pipeline"
    tag "subworkflows/utils_nfcore_viralmetagenome_pipeline"
    tag "lazymap_test"

    test("vanilla JsonSlurper test (broken behaviour) - should return >0 NPEs") {
        when {
            workflow {
                """
                input[0] = 'vanilla'
                input[1] = 64       // n_threads
                input[2] = 20000    // max_rounds
                input[3] = 60       // time_budget_s
                input[4] = 2000     // nested_keys
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // > 0 — vanilla MUST race, otherwise the second test isn't a guard.
                // (Count varies per run, so it stays an explicit assert, not snapshot.)
                { assert (workflow.out.errors[0] as Integer) > 0 },
                { assert snapshot(
                    workflow.out.inner_class,
                    workflow.out.first_error
                    ).match() }
            )
        }
    }

    test("getMapFromJson test (current fix) - should return 0 NPEs") {
        when {
            workflow {
                """
                input[0] = 'current'
                input[1] = 64
                input[2] = 20000
                input[3] = 60
                input[4] = 2000
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert (workflow.out.errors[0] as Integer) == 0 },
                { assert snapshot(
                    workflow.out.inner_class,
                    workflow.out.first_error
                    ).match() }
            )
        }
    }
}
