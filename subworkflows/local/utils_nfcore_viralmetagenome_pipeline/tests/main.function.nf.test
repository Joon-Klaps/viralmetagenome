// Behavioral tests for getMapFromJson — guard for the LazyMap thread-safety
// fix in https://github.com/nf-core/viralmetagenome/issues/290.
//

nextflow_function {

    name "Test Functions utils_nfcore_viralmetagenome_pipeline"
    script "../main.nf"
    tag "subworkflows"
    tag "subworkflows_local"
    tag "utils_nfcore_viralmetagenome_pipeline"
    tag "subworkflows/utils_nfcore_viralmetagenome_pipeline"

    test("getMapFromJson parses extract_cluster.py JSON shape") {

        function "getMapFromJson"

        when {
            function {
                """
                def fixture = file("\${workDir}/cluster_meta.json")
                fixture.text = '''{
                    "cluster_id": "cl17",
                    "centroid": "NODE_42_length_5123_cov_18.4",
                    "cluster_size": 12,
                    "cumulative_read_depth": {"spades": 184.2, "megahit": 0.0, "trinity": 0.0},
                    "external_reference": false,
                    "members": ["a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l"],
                    "taxid": "11320"
                }'''
                input[0] = fixture
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result.cluster_id == 'cl17' },
                { assert function.result.cluster_size == 12 },
                { assert function.result.external_reference == false },
                { assert function.result.taxid == '11320' },
                { assert function.result.members.size() == 12 },
                { assert function.result.cumulative_read_depth.spades == 184.2 },
                { assert function.result.centroid == 'NODE_42_length_5123_cov_18.4' }
            )
        }
    }

    test("getMapFromJson parses extract_precluster.py JSON shape") {

        function "getMapFromJson"

        when {
            function {
                """
                def fixture = file("\${workDir}/precluster.json")
                fixture.text = '{"ntaxa": 7}'
                input[0] = fixture
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result.ntaxa == 7 }
            )
        }
    }
}
