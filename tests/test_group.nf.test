nextflow_pipeline {

    name "Test pipeline with test_group profile"
    script "../main.nf"
    tag "pipeline"
    tag "test_group"
    profile "test_group"

    test("-profile test_group") {

        when {
            params {
                outdir = "$outputDir"
                transpose_overview_tables = true
            }
        }

        then {

            // Output directory: multiqc
            def stable_name_multiqc = getAllFilesFromDir(
                params.outdir, include: ['multiqc/**'], relative: true, includeDir: false
            )
            def stable_path_multiqc = getAllFilesFromDir(
                params.outdir, include: ['multiqc/**'], ignoreFile: 'tests/.nftignore'
            )
            def output_samples_csv = path(params.outdir + '/overview-tables/samples_overview.tsv').csv(sep:"\t")
            def output_contigs_csv = path(params.outdir + '/overview-tables/contigs_overview-with-iterations.tsv').csv(sep:"\t")

            assert workflow.success
            assertAll(
                { assert snapshot(
                    // Number of successful tasks
                    workflow.trace.succeeded().size(),
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_viralmetagenome_software_mqc_versions.yml"),
                    output_samples_csv.columnNames.sort(),
                    output_samples_csv.columns["sample"].sort(),
                    output_contigs_csv.columnNames.sort(),
                    output_contigs_csv.columns["index"].sort(),
                ).match() },
                { assert snapshot(stable_name_multiqc, stable_path_multiqc).match('multiqc') },
            )
        }
    }
}
